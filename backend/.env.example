# ── Server ─────────────────────────────────────────────
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Private study: confirm the account is on Groq Free before changing to true.
# Shared by ALL Edu AI text calls and the OCR worker. See docs/private-study.md.
STUDY_GROQ_FREE_PLAN_CONFIRMED=false
STUDY_TEXT_MODEL=openai/gpt-oss-120b
STUDY_VISION_MODEL=qwen/qwen3.8-27b
# Conservative Free-account OCR output cap. Dense pages can be partial; valid 512-3500.
STUDY_VISION_MAX_OUTPUT=512
STUDY_GROQ_RPM=30
STUDY_GROQ_RPD=1000
STUDY_GROQ_TPM=8000
STUDY_GROQ_TPD=200000
STUDY_AI_REQUESTS_DAY=20
STUDY_VISION_PAGES_PER_DAY=10
STUDY_MAX_OUTPUT_TOKENS=2000
STUDY_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
STUDY_EMBEDDING_URL=http://127.0.0.1:8091
STUDY_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
STUDY_STORE_PAGE_IMAGES=false

# ── Neon PostgreSQL (Drizzle) ─────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=replace-with-32+-char-random-string
JWT_REFRESH_SECRET=replace-with-different-32+-char-string

# ── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# ── Clerk Authentication ───────────────────────────────
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# ── GitHub OAuth ───────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback

# ── Admin & Professor ──────────────────────────────────
ADMIN_EMAIL=your-admin-email@example.com
PROFESSOR_PIN=change-this-pin

# ── Tigris S3-Compatible Storage ───────────────────────
AWS_ACCESS_KEY_ID=your-tigris-access-key-id
AWS_SECRET_ACCESS_KEY=your-tigris-secret-access-key
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_ENDPOINT_URL_IAM=https://fly.storage.tigris.dev
AWS_BUCKET_NAME=your-bucket-name
