# ─── Database ────────────────────────────────────────────────────────────────
# Required — PostgreSQL connection string (Neon, Supabase, or self-hosted)
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# Required — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=production
CLIENT_URL=https://www.edusphere.live

# ─── Cookie settings (production) ────────────────────────────────────────────
COOKIE_DOMAIN=.edusphere.live
COOKIE_SAMESITE=none

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.edusphere.live/api/auth/google/callback

# ─── Clerk Authentication ──────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_qrUMME45Y4JoFEy8Hu4UpkK75UMQpFpxYEc83iXtnB
CLERK_PUBLISHABLE_KEY=pk_test_cmVuZXdlZC1zbHVnLTg5LmNsZXJrLmFjY291bnRzLmRldiQ

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://api.edusphere.live/api/auth/github/callback

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=your_admin_email@example.com

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name

# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ─── Redis (OPTIONAL — safe to omit, app runs without it) ────────────────────
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_CACHE_PREFIX=edusphere:cache
# REDIS_CACHE_TTL=120
