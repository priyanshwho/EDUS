# ── Server ─────────────────────────────────────────────
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# ── Neon PostgreSQL (Drizzle) ─────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=replace-with-32+-char-random-string
JWT_REFRESH_SECRET=replace-with-different-32+-char-string

# ── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# ── Clerk Authentication ───────────────────────────────
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# ── GitHub OAuth ───────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback

# ── Admin & Professor ──────────────────────────────────
ADMIN_EMAIL=your-admin-email@example.com
PROFESSOR_PIN=change-this-pin

# ── Tigris S3-Compatible Storage ───────────────────────
AWS_ACCESS_KEY_ID=your-tigris-access-key-id
AWS_SECRET_ACCESS_KEY=your-tigris-secret-access-key
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_ENDPOINT_URL_IAM=https://fly.storage.tigris.dev
AWS_BUCKET_NAME=your-bucket-name
