[Unit]
Description=EduSphere private study ingestion and cleanup
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/EDUS/backend/study-worker
EnvironmentFile=%h/EDUS/backend/.env
Environment=HF_HOME=%h/.cache/edus-study/huggingface
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=PYTHONUNBUFFERED=1
# Host-specific user-local Tesseract installation on Linux arm64.
Environment=PATH=%h/.local/share/edus-study/tesseract/usr/bin:/usr/local/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=%h/.local/share/edus-study/tesseract/usr/lib/aarch64-linux-gnu
Environment=TESSDATA_PREFIX=%h/.local/share/edus-study/tesseract/usr/share/tesseract-ocr/5/tessdata
ExecStart=%h/.local/share/edus-study/venv/bin/python -m study_worker work
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
Nice=10
MemoryHigh=1800M
MemoryMax=2G
CPUQuota=150%
TasksMax=128

[Install]
WantedBy=default.target
