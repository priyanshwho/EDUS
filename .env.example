# EduSphere — Root .env.example
# Copy this file to .env or supply values directly to backend/.env

# ── Backend: Server ────────────────────────────────────
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Backend: Neon PostgreSQL ───────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxxxx.region.aws.neon.tech/edusphere?sslmode=require

# ── Backend: JWT ───────────────────────────────────────
JWT_SECRET=replace-with-32+-char-random-string
JWT_REFRESH_SECRET=replace-with-different-32+-char-string

# ── Backend: Google OAuth ──────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
## GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
# GOOGLE_CALLBACK_URL=https://thirty-rockets-pay.loca.lt/api/auth/google/callback

GOOGLE_CALLBACK_URL=https://api.edusphere.live/api/auth/google/callback
# ── Backend: GitHub OAuth ──────────────────────────────
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
## GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback
GITHUB_CALLBACK_URL=https://api.edusphere.live/api/auth/github/callback

# ── Backend: Admin & Professor ─────────────────────────
ADMIN_EMAIL=priyanshu82711@gmail.com
PROFESSOR_PIN=123456

# ── Backend: Tigris S3-Compatible Storage ──────────────
AWS_ACCESS_KEY_ID=your-tigris-access-key-id
AWS_SECRET_ACCESS_KEY=your-tigris-secret-access-key
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_ENDPOINT_URL_IAM=https://fly.storage.tigris.dev
AWS_BUCKET_NAME=your-tigris-bucket-name

# ── Frontend (Vite) ────────────────────────────────────
VITE_API_URL=http://localhost:5001/api
# VITE_API_URL=https://api.edusphere.live/api
