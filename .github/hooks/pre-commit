#!/bin/bash

# Git Pre-commit Hook for EduSphere
# Prevents commits that violate project conventions
#
# Install with: cp .github/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🔍 Running pre-commit checks...${NC}"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# ─────────────────────────────────────────────────────────────────
# 1. Check for .env files (should never be committed)
# ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}1. Checking for .env files...${NC}"
if echo "$STAGED_FILES" | grep -qE "\.env(\.|$)"; then
    echo -e "${RED}❌ ERROR: .env files should not be committed${NC}"
    echo "   Staged files:"
    echo "$STAGED_FILES" | grep "\.env" | sed 's/^/     /'
    exit 1
fi
echo -e "${GREEN}✓ No .env files${NC}"

# ─────────────────────────────────────────────────────────────────
# 2. Check for console.log statements
# ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}2. Checking for console.log statements...${NC}"
CONSOLE_LOGS=$(echo "$STAGED_FILES" | grep -E "\.(js|jsx)$" | while read file; do
    if git show ":$file" 2>/dev/null | grep -nE "console\.(log|warn|error|debug)" | grep -v "// console.log"; then
        echo "$file"
    fi
done)

if [ -n "$CONSOLE_LOGS" ]; then
    echo -e "${RED}❌ ERROR: console statements found in staged files:${NC}"
    echo "$CONSOLE_LOGS" | sed 's/^/     /'
    echo -e "\n${YELLOW}Tip: Remove or comment out console statements before committing${NC}"
    exit 1
fi
echo -e "${GREEN}✓ No console.log statements${NC}"

# ─────────────────────────────────────────────────────────────────
# 3. Check for debugger statements
# ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}3. Checking for debugger statements...${NC}"
DEBUGGERS=$(echo "$STAGED_FILES" | grep -E "\.(js|jsx)$" | while read file; do
    if git show ":$file" 2>/dev/null | grep -n "debugger"; then
        echo "$file"
    fi
done)

if [ -n "$DEBUGGERS" ]; then
    echo -e "${RED}❌ ERROR: debugger statements found:${NC}"
    echo "$DEBUGGERS" | sed 's/^/     /'
    exit 1
fi
echo -e "${GREEN}✓ No debugger statements${NC}"

# ─────────────────────────────────────────────────────────────────
# 4. Check for hardcoded API keys/secrets
# ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}4. Checking for hardcoded secrets...${NC}"
SECRETS=$(echo "$STAGED_FILES" | grep -E "\.(js|jsx)$" | while read file; do
    if git show ":$file" 2>/dev/null | grep -iE "(api_key|secret|password|token)\s*[=:]\s*['\"]" | grep -v "\/\/"; then
        echo "$file"
    fi
done)

if [ -n "$SECRETS" ]; then
    echo -e "${RED}❌ ERROR: hardcoded secrets detected:${NC}"
    echo "$SECRETS" | sed 's/^/     /'
    echo -e "\n${YELLOW}Tip: Move secrets to .env files${NC}"
    exit 1
fi
echo -e "${GREEN}✓ No hardcoded secrets${NC}"

# ─────────────────────────────────────────────────────────────────
# 5. Check component naming conventions (PascalCase)
# ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}5. Checking component naming conventions...${NC}"
COMPONENT_ISSUES=$(echo "$STAGED_FILES" | grep "frontend/src/components" | while read file; do
    filename=$(basename "$file")
    # Check if it matches PascalCase pattern
    if ! [[ $filename =~ ^[A-Z][a-zA-Z0-9_]*\.(jsx|js)$ ]] && ! [[ $filename =~ ^[a-z_]+\.css$ ]]; then
        echo "$file"
    fi
done)

if [ -n "$COMPONENT_ISSUES" ]; then
    echo -e "${RED}⚠️  WARNING: Component files should use PascalCase:${NC}"
    echo "$COMPONENT_ISSUES" | sed 's/^/     Example: NewComponent.jsx/'
fi
echo -e "${GREEN}✓ Component naming checked${NC}"

# ─────────────────────────────────────────────────────────────────
# 6. Check page naming conventions (_Page suffix)
# ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}6. Checking page naming conventions...${NC}"
PAGE_ISSUES=$(echo "$STAGED_FILES" | grep "frontend/src/Pages" | while read file; do
    filename=$(basename "$file")
    if [[ $filename =~ \.jsx$ ]] && ! [[ $filename =~ _Page\.jsx$ ]] && ! [[ $filename =~ \.(css|json)$ ]]; then
        # Exception for index files
        if [[ $filename != "index.jsx" ]]; then
            echo "$file"
        fi
    fi
done)

if [ -n "$PAGE_ISSUES" ]; then
    echo -e "${RED}⚠️  WARNING: Page files should end with _Page.jsx:${NC}"
    echo "$PAGE_ISSUES" | sed 's/^/     Example: Lectures_Page.jsx/'
fi
echo -e "${GREEN}✓ Page naming checked${NC}"

# ─────────────────────────────────────────────────────────────────
# 7. Check route/controller naming conventions (kebab-case)
# ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}7. Checking route/controller naming conventions...${NC}"
BACKEND_ISSUES=$(echo "$STAGED_FILES" | grep -E "backend/src/(routes|controllers)" | while read file; do
    filename=$(basename "$file")
    # Should be kebab-case.js or kebab-case.controller.js
    if [[ $filename =~ ^[A-Z].*\.js$ ]]; then
        echo "$file"
    fi
done)

if [ -n "$BACKEND_ISSUES" ]; then
    echo -e "${RED}⚠️  WARNING: Route/controller files should use kebab-case:${NC}"
    echo "$BACKEND_ISSUES" | sed 's/^/     Example: resource-upload.routes.js/'
fi
echo -e "${GREEN}✓ Backend naming checked${NC}"

# ─────────────────────────────────────────────────────────────────
# 8. Run ESLint on staged files (frontend)
# ─────────────────────────────────────────────────────────────────
if echo "$STAGED_FILES" | grep -q "frontend/.*\.(js|jsx)$"; then
    echo -e "\n${YELLOW}8. Running ESLint on frontend files...${NC}"
    cd frontend
    
    if command -v npx &> /dev/null; then
        # Only lint staged files
        FRONTEND_STAGED=$(echo "$STAGED_FILES" | grep "frontend/.*\.(js|jsx)$" | sed 's/^frontend\///')
        
        if [ -n "$FRONTEND_STAGED" ]; then
            if npx eslint --max-warnings 0 $FRONTEND_STAGED 2>/dev/null; then
                echo -e "${GREEN}✓ ESLint passed${NC}"
            else
                echo -e "${RED}❌ ESLint errors found${NC}"
                echo -e "${YELLOW}Tip: Run 'npm run lint' to see full output${NC}"
                cd ..
                exit 1
            fi
        fi
    else
        echo -e "${YELLOW}⚠️  ESLint not available, skipping...${NC}"
    fi
    
    cd ..
fi

# ─────────────────────────────────────────────────────────────────
# 9. Check for merge conflicts
# ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}9. Checking for merge conflict markers...${NC}"
CONFLICTS=$(echo "$STAGED_FILES" | while read file; do
    if git show ":$file" 2>/dev/null | grep -qE "^(<<<<<<<|=======|>>>>>>>)"; then
        echo "$file"
    fi
done)

if [ -n "$CONFLICTS" ]; then
    echo -e "${RED}❌ ERROR: Merge conflict markers found:${NC}"
    echo "$CONFLICTS" | sed 's/^/     /'
    exit 1
fi
echo -e "${GREEN}✓ No merge conflicts${NC}"

# ─────────────────────────────────────────────────────────────────
# 10. Check JSON syntax
# ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}10. Checking JSON files syntax...${NC}"
JSON_ISSUES=$(echo "$STAGED_FILES" | grep "\.json$" | while read file; do
    if ! python3 -m json.tool ":$file" >/dev/null 2>&1; then
        echo "$file"
    fi
done)

if [ -n "$JSON_ISSUES" ]; then
    echo -e "${RED}❌ ERROR: Invalid JSON syntax:${NC}"
    echo "$JSON_ISSUES" | sed 's/^/     /'
    exit 1
fi
echo -e "${GREEN}✓ JSON syntax valid${NC}"

# ─────────────────────────────────────────────────────────────────
# Success
# ─────────────────────────────────────────────────────────────────
echo -e "\n${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0
